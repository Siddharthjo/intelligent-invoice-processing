DATABASE_URL=postgresql+psycopg://invoice_app:invoice_app@localhost:5432/invoice_processing

MAX_UPLOAD_SIZE_BYTES=20971520

OCR_ENABLED=true
OCR_DPI=300
TEXT_LAYER_MIN_CHARS_PER_PAGE=20

OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_TOOL_TURNS=8
AGENT_CALL_TIMEOUT_SECONDS=30.0
AGENT_PO_VARIANCE_TOLERANCE_GOODS_PCT=0.02
AGENT_PO_VARIANCE_TOLERANCE_SERVICES_PCT=0.05
AGENT_PO_VARIANCE_TOLERANCE_INDIRECT_PCT=0.08

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Scope this before enabling against a real inbox -- e.g. add a date window
# (newer_than:7d) and/or restrict to a dedicated label/folder (label:invoices)
# rather than matching every PDF attachment you've ever received.
GMAIL_QUERY=has:attachment filename:pdf newer_than:7d
GMAIL_PROCESSED_LABEL=invoice-processed
GMAIL_FAILED_LABEL=invoice-intake-failed
GMAIL_POLL_INTERVAL_MINUTES=
